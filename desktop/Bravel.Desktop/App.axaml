<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bravel.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#EDEFFB" /></Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#D5DBFF" />
      <Setter Property="Foreground" Value="#161B35" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="Padding" Value="14,11" />
    </Style>
  </Application.Styles>
</Application>
