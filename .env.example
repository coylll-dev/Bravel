# Copy to ~/.config/bravel/.env (Windows: %USERPROFILE%\.config\bravel\.env).
# Alternatively set BRAVEL_ENV to the absolute path to your own file.
# Environment variables override this file. Project .env files are not auto-loaded.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=45
AI_JSON_MODE=true
AI_MAX_STEPS=5
# Set false for HTTP local endpoints; no Authorization header will be sent.
AI_REQUIRE_KEY=true
# auto, always, never
AI_COLOR=auto
